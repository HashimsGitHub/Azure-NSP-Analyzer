# Azure-NSP-Analyzer Environment Configuration
# Copy this file to .env and fill in your actual values
# The .env file is git-ignored and will never be committed to GitHub

# REQUIRED: Your Azure Log Analytics Workspace UUID
# Find this in Azure Portal: Log Analytics Workspace → Properties → Workspace ID
LOG_ANALYTICS_WORKSPACE_ID=your-workspace-uuid-here

# OPTIONAL: Display name for the workspace (default: law-nsp-poc)
WORKSPACE_NAME=law-nsp-poc

# OPTIONAL: Azure service tag for NSP rules (default: ContainerAppsManagement.AustraliaEast)
# Change based on your region:
# - AustraliaEast: ContainerAppsManagement.AustraliaEast
# - EastUS: ContainerAppsManagement.EastUS
# - WestEurope: ContainerAppsManagement.WestEurope
# See: https://learn.microsoft.com/en-us/azure/virtual-network/service-tags-overview
NSP_SERVICE_TAG=ContainerAppsManagement.AustraliaEast
